K_WEATHER_DB=yukon_weather/k-weather.sqlite3
K_WEATHER_USERNAME=weather
K_WEATHER_PASSWORD=generate-a-long-random-password
K_WEATHER_SECRET_KEY=generate-a-separate-random-session-signing-key
# Optional for local/manual refreshes; production scheduling uses GitHub OIDC.
K_WEATHER_REFRESH_TOKEN=generate-an-optional-random-token

# Optional household station capture. Keep real values only in private secret stores.
MYACURITE_EMAIL=account-email@example.invalid
MYACURITE_PASSWORD=account-password

# Optional encrypted Google Drive backup. Real files must have mode 0600.
K_WEATHER_BACKUP_REPOSITORY=rclone:google-drive:k-weather
K_WEATHER_RESTIC_PASSWORD_FILE=/private/path/restic-password
RCLONE_CONFIG=/private/path/rclone.conf
